# RPC URL for the network you want to deploy to (e.g., Alchemy or Infura)
SEPOLIA_RPC_URL="https://eth-sepolia.g.alchemy.com/v2/your_alchemy_api_key_here"

# The private key of the account you want to deploy from 
# WARNING: NEVER commit your real private key to Git! Use a dedicated testing wallet.
DEPLOYER_PRIVATE_KEY="your_wallet_private_key_here"

# Etherscan API key for verifying smart contracts
ETHERSCAN_API_KEY="your_etherscan_api_key_here"
