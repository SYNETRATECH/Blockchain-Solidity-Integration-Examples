{
    "name": "greeter/php-client",
    "description": "A PHP client for interacting with the blockchain via JSON-RPC",
    "type": "project",
    "require": {
        "php": ">=8.0",
        "ext-gmp": "*",
        "ext-bcmath": "*",
        "web3p/web3.php": "^0.2.0",
        "web3p/ethereum-tx": "^0.4.0",
        "kornrunner/keccak": "^1.1"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.0",
        "phpstan/phpstan": "^1.10",
        "friendsofphp/php-cs-fixer": "^3.40"
    },
    "autoload": {
        "psr-4": {
            "App\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit tests",
        "analyze": "phpstan analyse src tests",
        "format": "php-cs-fixer fix src tests"
    }
}
